+static void hetgpu_iq1s_note_route_weights(cudaStream_t stream, const ggml_tensor * tensor) {
+    if (!hetgpu_tq1_env_is_one("HETGPU_QWEN_IQ1S_STRICT")) {
+        return;
+    }
+    uint32_t layer = UINT32_MAX;
+    if (!hetgpu_iq1s_route_weight_name(tensor->name, layer)) {
+        return;
+    }
+    if (tensor->type != GGML_TYPE_F32 || tensor->data == nullptr || !ggml_is_contiguous(tensor)) {
+        GGML_ABORT("strict HetGPU IQ1_S route weights must be contiguous F32 device data");
+    }
+    std::lock_guard<std::mutex> guard(hetgpu_iq1s_streams_lock);
+    auto & state = hetgpu_iq1s_streams[reinterpret_cast<void *>(stream)];
+    if (state.transaction != 0 && state.layer != layer &&
+        !hetgpu_iq1s_try_close_gpu_down(state)) {
+        hetgpu_iq1s_fail_locked(state, 2, "IQ1_S layer changed before the prior transaction closed");
+    }
+    state.route_layer = layer;
+    state.route_weights = static_cast<const float *>(tensor->data);
+    state.route_weight_count = ggml_nelements(tensor);
+}
+
+constexpr uint32_t max_batch = 32;
+constexpr uint32_t top_k = 10;
+
+static void hetgpu_iq1s_ensure_token_ids(
+        hetgpu_iq1s_stream_state & state, cudaStream_t stream) {
+    if (state.token_ids_device != nullptr) {
+        return;
+    }
+    static const std::array<uint32_t, max_batch * top_k> token_ids = [] {
+        std::array<uint32_t, max_batch * top_k> ids = {};
+        for (uint32_t token = 0; token < max_batch; ++token) {
+            for (uint32_t route = 0; route < top_k; ++route) {
+                ids[token * top_k + route] = token;
+            }
+        }
+        return ids;
+    }();
+    const cudaError_t alloc_error = cudaMalloc(
+        reinterpret_cast<void **>(&state.token_ids_device), sizeof(token_ids));
+    if (alloc_error != cudaSuccess) {
+        GGML_ABORT("failed to allocate IQ1_S positional route IDs: %s", cudaGetErrorString(alloc_error));
+    }
+    const cudaError_t copy_error = cudaMemcpyAsync(
+        state.token_ids_device, token_ids.data(), sizeof(token_ids), cudaMemcpyHostToDevice, stream);
+    if (copy_error != cudaSuccess) {
+        GGML_ABORT("failed to upload IQ1_S positional route IDs: %s", cudaGetErrorString(copy_error));
+    }
+    const cudaError_t expert_alloc_error = cudaMalloc(
+        reinterpret_cast<void **>(&state.expert_ids_device), max_batch * top_k * sizeof(int32_t));
+    if (expert_alloc_error != cudaSuccess) {
+        GGML_ABORT("failed to allocate IQ1_S packed expert IDs: %s", cudaGetErrorString(expert_alloc_error));
+    }
+}
+
+static hetgpu_iq1s_projection_role hetgpu_iq1s_before_projection(
+        ggml_backend_cuda_context & ctx, const ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * ids = dst->src[2];
+    uint32_t layer = UINT32_MAX;
+    hetgpu_iq1s_projection_role role = hetgpu_iq1s_projection_role::none;
+    constexpr size_t top_k_bytes = top_k * sizeof(int32_t);
+    if (!hetgpu_tq1_env_is_one("HETGPU_QWEN_IQ1S_STRICT") || src0->type != GGML_TYPE_IQ1_S ||
+        !hetgpu_iq1s_parse_projection(src0->name, layer, role)) {
+        return hetgpu_iq1s_projection_role::none;
+    }
+    if (ids == nullptr || ids->type != GGML_TYPE_I32 || ids->data == nullptr ||
+        ids->ne[0] != top_k || ids->ne[1] < 1 || ids->ne[1] > max_batch ||
+        ids->ne[2] != 1 || ids->ne[3] != 1 ||
+        ids->nb[0] != sizeof(int32_t) || ids->nb[1] < top_k_bytes) {
+        GGML_ABORT("strict HetGPU IQ1_S requires strided top-10 IDs for 1..32 tokens");
+    }
+
+    cudaStream_t stream = ctx.stream();
+    void * stream_key = reinterpret_cast<void *>(stream);
+    std::lock_guard<std::mutex> guard(hetgpu_iq1s_streams_lock);
+    auto & state = hetgpu_iq1s_streams[stream_key];
+    for (auto & entry : hetgpu_iq1s_streams) {
+        if (entry.first != stream_key && entry.second.transaction != 0 && entry.second.layer == layer) {
+            hetgpu_iq1s_fail_locked(
+                entry.second, 3, "IQ1_S layer projections moved to a different CUDA stream");
+        }
+    }
+    if (state.transaction == 0) {
+        if (role == hetgpu_iq1s_projection_role::down) {
+            GGML_ABORT("IQ1_S down projection arrived without an open gate/up transaction");
+        }
+        const size_t assignment_count = static_cast<size_t>(ids->ne[0] * ids->ne[1]);
+        if (state.route_layer != layer || state.route_weights == nullptr ||
+            state.route_weight_count != assignment_count) {
+            GGML_ABORT("IQ1_S projection has no matching completed route-weight tensor");
+        }
+        const auto & hooks = hetgpu_iq1s_hooks();
+        if (!hetgpu_iq1s_hooks_complete(hooks)) {
+            GGML_ABORT("strict HetGPU IQ1_S v2 lifecycle hooks are unavailable");
+        }
+        hetgpu_iq1s_ensure_token_ids(state, stream);
+        const cudaError_t pack_error = cudaMemcpy2DAsync(
+            state.expert_ids_device, top_k_bytes,
+            ids->data, ids->nb[1], top_k_bytes, static_cast<size_t>(ids->ne[1]),
+            cudaMemcpyDeviceToDevice, stream);
+        if (pack_error != cudaSuccess) {
+            GGML_ABORT("failed to pack IQ1_S top-10 expert IDs: %s", cudaGetErrorString(pack_error));
+        }
+        const uint64_t transaction = hetgpu_iq1s_next_transaction.fetch_add(1, std::memory_order_relaxed);
+        if (transaction == 0) {
+            GGML_ABORT("HetGPU IQ1_S transaction counter overflow");
+        }
+        const int begin_result = hooks.begin(
+            HETGPU_IQ1S_LAYER_ABI_VERSION, layer, transaction,
+            static_cast<uint32_t>(ids->ne[1]), stream_key);
+        if (begin_result != HETGPU_IQ1S_HANDLED) {
+            GGML_ABORT("HetGPU IQ1_S layer begin hook failed");
+        }
+        state.layer = layer;
+        state.transaction = transaction;
+        hetgpu_iq1s_active_stream = stream_key;
+        const int set_routes_result = hooks.set_routes(
+            HETGPU_IQ1S_LAYER_ABI_VERSION, transaction, state.token_ids_device,
+            static_cast<const int32_t *>(state.expert_ids_device), state.route_weights, 10);
+        if (set_routes_result != HETGPU_IQ1S_HANDLED) {
+            hetgpu_iq1s_fail_locked(state, 4, "HetGPU IQ1_S set-routes hook failed");
+        }
+    } else if (state.layer != layer) {
+        hetgpu_iq1s_fail_locked(state, 5, "IQ1_S projection layer does not match open transaction");
+    }
+    return role;
+}
+
+static void hetgpu_iq1s_commit_after_down(
+        const hetgpu_iq1s_layer_hooks & hooks, hetgpu_iq1s_stream_state & state) {
+    if (!state.phase_a_committed || state.down_seen) {
+        hetgpu_iq1s_fail_locked(state, 6, "IQ1_S down projection is out of order");
+    }
+    state.down_seen = true;
+    const int commit_result = hooks.commit(HETGPU_IQ1S_LAYER_ABI_VERSION, state.transaction);
+    if (commit_result != HETGPU_IQ1S_HANDLED) {
+        hetgpu_iq1s_fail_locked(state, 7, "HetGPU IQ1_S layer commit hook failed");
+    }
+    hetgpu_iq1s_clear_transaction(state);
+    hetgpu_iq1s_active_stream = nullptr;
+}
+
+static void hetgpu_iq1s_after_projection(
+        ggml_backend_cuda_context & ctx, const ggml_tensor * dst, hetgpu_iq1s_projection_role role) {
+    if (role == hetgpu_iq1s_projection_role::none) {
+        return;
+    }
+    uint32_t layer = UINT32_MAX;
+    hetgpu_iq1s_projection_role parsed_role = hetgpu_iq1s_projection_role::none;
+    if (!hetgpu_iq1s_parse_projection(dst->src[0]->name, layer, parsed_role) || parsed_role != role) {
+        GGML_ABORT("IQ1_S projection identity changed during execution");
+    }
+    std::lock_guard<std::mutex> guard(hetgpu_iq1s_streams_lock);
+    auto & state = hetgpu_iq1s_streams[reinterpret_cast<void *>(ctx.stream())];
+    if (state.transaction == 0 || state.layer != layer) {
+        hetgpu_iq1s_fail_locked(state, 8, "IQ1_S projection completed outside its transaction");
+    }
+    switch (role) {
+        case hetgpu_iq1s_projection_role::gate:
+            if (state.gate_seen) {
+                hetgpu_iq1s_fail_locked(state, 9, "duplicate IQ1_S gate projection");
+            }
+            state.gate_seen = true;
+            break;
+        case hetgpu_iq1s_projection_role::up:
+            if (state.up_seen) {
+                hetgpu_iq1s_fail_locked(state, 10, "duplicate IQ1_S up projection");
+            }
+            state.up_seen = true;
+            break;
+        case hetgpu_iq1s_projection_role::gate_up:
+            if (state.gate_seen || state.up_seen) {
+                hetgpu_iq1s_fail_locked(state, 11, "duplicate IQ1_S merged gate/up projection");
+            }
+            state.gate_seen = true;
+            state.up_seen = true;
+            break;
+        case hetgpu_iq1s_projection_role::down:
+            hetgpu_iq1s_commit_after_down(hetgpu_iq1s_hooks(), state);
+            return;
+        case hetgpu_iq1s_projection_role::none:
+            GGML_ABORT("invalid IQ1_S projection role");
+    }
+    if (state.gate_seen && state.up_seen && !state.phase_a_committed) {
+        const auto & hooks = hetgpu_iq1s_hooks();
+        const int phase_commit_result = hooks.phase_commit(
+            HETGPU_IQ1S_LAYER_ABI_VERSION, state.transaction, HETGPU_IQ1S_LAYER_PHASE_A);
+        if (phase_commit_result != HETGPU_IQ1S_HANDLED) {
+            hetgpu_iq1s_fail_locked(state, 12, "HetGPU IQ1_S Phase A commit hook failed");
+        }
+        state.phase_a_committed = true;
+    }
+}
+
+static void hetgpu_iq1s_graph_boundary(const char * boundary) {
+    if (!hetgpu_tq1_env_is_one("HETGPU_QWEN_IQ1S_STRICT")) {
+        return;
+    }
+    std::lock_guard<std::mutex> guard(hetgpu_iq1s_streams_lock);
+    for (auto & entry : hetgpu_iq1s_streams) {
+        if (entry.second.transaction != 0 && !hetgpu_iq1s_try_close_gpu_down(entry.second)) {
+            hetgpu_iq1s_abort_checked(entry.second, 13);
+            GGML_ABORT("IQ1_S graph %s found an incomplete layer transaction", boundary);
+        }
+    }
+}
