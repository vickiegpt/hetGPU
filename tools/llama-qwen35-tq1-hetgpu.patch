+struct hetgpu_iq1s_layer_hooks {
+    hetgpu_iq1s_layer_begin_v2_fn begin;
+    hetgpu_iq1s_layer_set_routes_v2_fn set_routes;
+    hetgpu_iq1s_layer_phase_commit_v2_fn phase_commit;
+    hetgpu_iq1s_layer_commit_v2_fn commit;
+    hetgpu_iq1s_layer_abort_v2_fn abort;
+};
+
+struct hetgpu_iq1s_stream_state {
+    uint32_t layer = UINT32_MAX;
+    uint64_t transaction = 0;
+    bool gate_seen = false;
+    bool up_seen = false;
+    bool down_seen = false;
+    bool phase_a_committed = false;
+    uint32_t route_layer = UINT32_MAX;
+    const float * route_weights = nullptr;
+    size_t route_weight_count = 0;
+    uint32_t * token_ids_device = nullptr;
+    int32_t * expert_ids_device = nullptr;
+};
+
+static std::mutex hetgpu_iq1s_streams_lock;
+static std::unordered_map<void *, hetgpu_iq1s_stream_state> hetgpu_iq1s_streams;
+static std::atomic<uint64_t> hetgpu_iq1s_next_transaction{1};
+static thread_local void * hetgpu_iq1s_active_stream = nullptr;
+
+static const hetgpu_iq1s_layer_hooks & hetgpu_iq1s_hooks() {
+#if defined(_WIN32)
+    static const hetgpu_iq1s_layer_hooks hooks = {};
+#else
+    static const hetgpu_iq1s_layer_hooks hooks = {
+        reinterpret_cast<hetgpu_iq1s_layer_begin_v2_fn>(
+            dlsym(RTLD_DEFAULT, "hetgpu_iq1s_layer_begin_v2")),
+        reinterpret_cast<hetgpu_iq1s_layer_set_routes_v2_fn>(
+            dlsym(RTLD_DEFAULT, "hetgpu_iq1s_layer_set_routes_v2")),
+        reinterpret_cast<hetgpu_iq1s_layer_phase_commit_v2_fn>(
+            dlsym(RTLD_DEFAULT, "hetgpu_iq1s_layer_phase_commit_v2")),
+        reinterpret_cast<hetgpu_iq1s_layer_commit_v2_fn>(
+            dlsym(RTLD_DEFAULT, "hetgpu_iq1s_layer_commit_v2")),
+        reinterpret_cast<hetgpu_iq1s_layer_abort_v2_fn>(
+            dlsym(RTLD_DEFAULT, "hetgpu_iq1s_layer_abort_v2")),
+    };
+#endif
+    return hooks;
+}
+
+static bool hetgpu_iq1s_hooks_complete(const hetgpu_iq1s_layer_hooks & hooks) {
+    return hooks.begin != nullptr && hooks.set_routes != nullptr && hooks.phase_commit != nullptr &&
+           hooks.commit != nullptr && hooks.abort != nullptr;
+}
+
+static bool hetgpu_iq1s_parse_layer(const char * begin, const char * end, uint32_t & layer) {
+    if (begin == end) {
+        return false;
+    }
+    uint32_t parsed = 0;
+    const auto result = std::from_chars(begin, end, parsed);
+    if (result.ec != std::errc() || result.ptr != end || parsed >= 60) {
+        return false;
+    }
+    layer = parsed;
+    return true;
+}
+
+static bool hetgpu_iq1s_parse_projection(
+        const char * name, uint32_t & layer, hetgpu_iq1s_projection_role & role) {
+    if (name == nullptr || strncmp(name, "blk.", 4) != 0) {
+        return false;
+    }
+    const char * digits = name + 4;
+    const char * cursor = digits;
+    while (*cursor >= '0' && *cursor <= '9') {
+        ++cursor;
+    }
+    if (!hetgpu_iq1s_parse_layer(digits, cursor, layer)) {
+        return false;
+    }
+    if (strcmp(cursor, ".ffn_gate_exps.weight") == 0) {
+        role = hetgpu_iq1s_projection_role::gate;
+    } else if (strcmp(cursor, ".ffn_up_exps.weight") == 0) {
+        role = hetgpu_iq1s_projection_role::up;
+    } else if (strcmp(cursor, ".ffn_down_exps.weight") == 0) {
+        role = hetgpu_iq1s_projection_role::down;
+    } else if (strcmp(cursor, ".ffn_gate_up_exps.weight") == 0) {
+        role = hetgpu_iq1s_projection_role::gate_up;
+    } else {
+        return false;
+    }
+    return true;
+}
+
+static bool hetgpu_iq1s_route_weight_name(const char * name, uint32_t & layer) {
+    constexpr const char * prefix = "ffn_moe_weights";
+    if (name == nullptr || strncmp(name, prefix, strlen(prefix)) != 0) {
+        return false;
+    }
+    const char * dash = strrchr(name, '-');
+    if (dash == nullptr || dash[1] == '\0') {
+        return false;
+    }
+    return hetgpu_iq1s_parse_layer(dash + 1, name + strlen(name), layer);
+}
+
+static void hetgpu_iq1s_clear_transaction(hetgpu_iq1s_stream_state & state) {
+    state.layer = UINT32_MAX;
+    state.transaction = 0;
+    state.gate_seen = false;
+    state.up_seen = false;
+    state.down_seen = false;
+    state.phase_a_committed = false;
+}
+
+static void hetgpu_iq1s_abort_checked(hetgpu_iq1s_stream_state & state, uint32_t reason) {
+    if (state.transaction == 0) {
+        return;
+    }
+    const auto & hooks = hetgpu_iq1s_hooks();
+    const uint64_t transaction = state.transaction;
+    const int abort_result = hooks.abort(
+        HETGPU_IQ1S_LAYER_ABI_VERSION, transaction, reason);
+    hetgpu_iq1s_clear_transaction(state);
+    hetgpu_iq1s_active_stream = nullptr;
+    if (abort_result != HETGPU_IQ1S_HANDLED) {
+        GGML_LOG_ERROR("HetGPU IQ1_S abort hook rejected transaction %" PRIu64 "\n", transaction);
+    }
+}
+
+static void hetgpu_iq1s_fail_locked(
+        hetgpu_iq1s_stream_state & state, uint32_t reason, const char * message) {
+    hetgpu_iq1s_abort_checked(state, reason);
+    GGML_ABORT("%s", message);
+}
+
+static void hetgpu_iq1s_abort_active_for_cuda_error() {
+    if (hetgpu_iq1s_active_stream == nullptr || !hetgpu_tq1_env_is_one("HETGPU_QWEN_IQ1S_STRICT")) {
+        return;
+    }
+    std::lock_guard<std::mutex> guard(hetgpu_iq1s_streams_lock);
+    auto found = hetgpu_iq1s_streams.find(hetgpu_iq1s_active_stream);
+    if (found != hetgpu_iq1s_streams.end()) {
+        hetgpu_iq1s_abort_checked(found->second, 1);
+    }
+}
+
+static bool hetgpu_iq1s_try_close_gpu_down(hetgpu_iq1s_stream_state & state) {
+    if (state.transaction == 0 || !state.phase_a_committed || state.down_seen) {
+        return false;
+    }
+    const auto & hooks = hetgpu_iq1s_hooks();
+    const int commit_result = hooks.commit(HETGPU_IQ1S_LAYER_ABI_VERSION, state.transaction);
+    if (commit_result != HETGPU_IQ1S_HANDLED) {
+        return false;
+    }
+    hetgpu_iq1s_clear_transaction(state);
+    hetgpu_iq1s_active_stream = nullptr;
+    return true;
+}
