+static bool hetgpu_tq1_expert_name(const char * name) {
+    if (name == nullptr || strncmp(name, "blk.", 4) != 0) {
+        return false;
+    }
+    const char * cursor = name + 4;
+    const char * digits = cursor;
+    while (*cursor >= '0' && *cursor <= '9') {
+        ++cursor;
+    }
+    if (cursor == digits || strncmp(cursor, ".ffn_", 5) != 0) {
+        return false;
+    }
+    cursor += 5;
+    return strcmp(cursor, "gate_exps.weight") == 0 ||
+           strcmp(cursor, "up_exps.weight") == 0 ||
+           strcmp(cursor, "down_exps.weight") == 0 ||
+           strcmp(cursor, "gate_up_exps.weight") == 0;
+}
