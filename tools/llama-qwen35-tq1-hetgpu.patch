+static uint64_t hetgpu_iq1s_allocation_generation(const char * name, const void * device_base) {
+    static std::mutex lock;
+    static std::unordered_map<std::string, std::pair<const void *, uint64_t>> allocations;
+    static std::atomic<uint64_t> next_generation{1};
+    std::lock_guard<std::mutex> guard(lock);
+    auto & allocation = allocations[std::string(name)];
+    if (allocation.first == device_base && allocation.second != 0) {
+        return allocation.second;
+    }
+    const uint64_t generation = next_generation.fetch_add(1, std::memory_order_relaxed);
+    if (generation == 0) {
+        GGML_ABORT("HetGPU IQ1_S allocation generation overflow");
+    }
+    allocation = {device_base, generation};
+    return generation;
+}
