+static size_t hetgpu_qwen35_cuda_buffer_max_size(ggml_backend_buffer_type_t buft) {
+    const char * value = getenv("HETGPU_QWEN35_CUDA_BUFFER_MAX_MIB");
+    if (value == nullptr) {
+        return SIZE_MAX;
+    }
+    char * end = nullptr;
+    errno = 0;
+    const unsigned long long mib = strtoull(value, &end, 10);
+    constexpr size_t bytes_per_mib = 1024ULL*1024ULL;
+    if (errno != 0 || end == value || *end != '\0' || mib < 1024 || mib > SIZE_MAX/bytes_per_mib) {
+        GGML_ABORT("HETGPU_QWEN35_CUDA_BUFFER_MAX_MIB must be an integer from 1024 through SIZE_MAX/MiB");
+    }
+    GGML_LOG_INFO("%s: limiting CUDA model buffers to %llu MiB\n", __func__, mib);
+    return static_cast<size_t>(mib)*bytes_per_mib;
+
+    GGML_UNUSED(buft);
+}
